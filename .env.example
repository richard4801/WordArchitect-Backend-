SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
OPENAI_API_KEY=your_openai_embedding_key
INFERMATIC_API_KEY=your_infermatic_api_key
INFERMATIC_BASE_URL=https://api.totalgpt.ai/v1
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-5
PORT=4000
MCP_API_KEY=generate_a_long_random_secret_for_this
JWT_SECRET=generate_a_long_random_secret_for_this_too
# Ghost Editor (banned terms): Sonnet rewrites the sentence holding each
# banned term; Hanami is the fallback when Sonnet declines a sentence.
# GHOST_EDITOR_MODEL defaults to claude-sonnet-5-5.
# GHOST_EDITOR_MODE=paragraph restores the old whole-paragraph Hanami rewrite.
GHOST_EDITOR_MODEL=claude-sonnet-5-5
# Drafting gates (default on). GO_GATE=off stops generate_prose_direct
# requiring a recorded Go; CARD_REVIEW_GATE=off stops record_prompt_approval
# requiring a beat card review; MANUSCRIPT_FIRST=off stops the name-lookup gate.
# GO_GATE=on
# CARD_REVIEW_GATE=on
# MANUSCRIPT_FIRST=on
